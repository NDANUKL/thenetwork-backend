{
  "doctype": "DocType",
  "name": "Scout Data Request",
  "module": "FieldPulse",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "user",
    "reason",
    "status",
    "public_reply",
    "internal_notes"
  ],
  "fields": [
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "options": "User",
      "label": "Scout account",
      "reqd": 1,
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "reason",
      "fieldtype": "Small Text",
      "label": "Request reason",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Open\nUnder review\nCompleted\nDeclined",
      "default": "Open",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "public_reply",
      "fieldtype": "Small Text",
      "label": "Outcome and retained records (visible to scout)"
    },
    {
      "fieldname": "internal_notes",
      "fieldtype": "Small Text",
      "label": "Private processing notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 0,
      "delete": 0,
      "report": 1
    },
    {
      "role": "Admin",
      "read": 1,
      "write": 1,
      "create": 0,
      "delete": 0,
      "report": 1
    }
  ]
}
