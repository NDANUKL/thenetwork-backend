{
  "doctype": "DocType",
  "name": "DD Scout Check",
  "module": "FieldPulse",
  "istable": 1,
  "editable_grid": 1,
  "fields": [
    {
      "fieldname": "question",
      "label": "Template question (optional)",
      "fieldtype": "Link",
      "options": "FP Question",
      "reqd": 0,
      "in_list_view": 0
    },
    {
      "fieldname": "label",
      "label": "Question",
      "fieldtype": "Small Text",
      "read_only": 0,
      "in_list_view": 1,
      "reqd": 1,
      "columns": 7
    },
    {
      "fieldname": "configuration_json",
      "label": "Assigned items and evidence settings",
      "fieldtype": "Code",
      "options": "JSON",
      "description": "Managed through Edit question and evidence.",
      "hidden": 1
    },
    {
      "fieldname": "check_key",
      "label": "Question reference",
      "fieldtype": "Data",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "instructions",
      "label": "Scout instructions",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "answer_format",
      "label": "Answer format",
      "fieldtype": "Select",
      "options": "Template format\nSingle choice\nMultiple choice\nWritten answer",
      "default": "Template format"
    },
    {
      "fieldname": "answer_options",
      "label": "Answer choices, one per line",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "evidence_mode",
      "label": "Evidence policy",
      "fieldtype": "Select",
      "options": "Keep template evidence\nSpecify evidence",
      "default": "Keep template evidence"
    },
    {
      "fieldname": "evidence_json",
      "label": "Evidence settings",
      "fieldtype": "Code",
      "options": "JSON",
      "hidden": 1
    },
    {
      "fieldname": "edit_question",
      "label": "Edit question and evidence",
      "fieldtype": "Button",
      "in_list_view": 1
    }
  ],
  "field_order": [
    "question",
    "label",
    "configuration_json",
    "check_key",
    "instructions",
    "answer_format",
    "answer_options",
    "evidence_mode",
    "evidence_json",
    "edit_question"
  ],
  "permissions": []
}
