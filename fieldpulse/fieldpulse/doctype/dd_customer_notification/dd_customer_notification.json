{
  "doctype": "DocType",
  "name": "DD Customer Notification",
  "module": "FieldPulse",
  "autoname": "field:event_key",
  "track_changes": 0,
  "field_order": [
    "event_key",
    "kind",
    "status",
    "request",
    "customer_account",
    "source_type",
    "source_name",
    "source_revision",
    "attempts",
    "next_attempt_at",
    "first_attempt_at",
    "sent_at",
    "provider_id",
    "last_error",
    "payload"
  ],
  "fields": [
    {
      "fieldname": "event_key",
      "fieldtype": "Data",
      "label": "Event key",
      "read_only": 1,
      "reqd": 1,
      "unique": 1,
      "hidden": 1
    },
    {
      "fieldname": "kind",
      "fieldtype": "Select",
      "label": "Update type",
      "read_only": 1,
      "options": "details\nquotation\npayment\nreport\ndispute\nrecurring",
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Delivery status",
      "read_only": 1,
      "options": "Pending\nSent\nSkipped\nNeeds review",
      "default": "Pending",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "request",
      "fieldtype": "Link",
      "label": "Request",
      "read_only": 1,
      "options": "Diaspora Request",
      "in_list_view": 1
    },
    {
      "fieldname": "customer_account",
      "fieldtype": "Link",
      "label": "Customer account",
      "read_only": 1,
      "options": "DD Customer Account"
    },
    {
      "fieldname": "source_type",
      "fieldtype": "Data",
      "label": "Source type",
      "read_only": 1
    },
    {
      "fieldname": "source_name",
      "fieldtype": "Data",
      "label": "Source record",
      "read_only": 1
    },
    {
      "fieldname": "source_revision",
      "fieldtype": "Data",
      "label": "Source revision",
      "read_only": 1
    },
    {
      "fieldname": "attempts",
      "fieldtype": "Int",
      "label": "Delivery attempts",
      "read_only": 1
    },
    {
      "fieldname": "next_attempt_at",
      "fieldtype": "Datetime",
      "label": "Next attempt",
      "read_only": 1
    },
    {
      "fieldname": "first_attempt_at",
      "fieldtype": "Datetime",
      "label": "First attempt",
      "read_only": 1
    },
    {
      "fieldname": "sent_at",
      "fieldtype": "Datetime",
      "label": "Accepted by email provider at",
      "read_only": 1
    },
    {
      "fieldname": "provider_id",
      "fieldtype": "Data",
      "label": "Email provider reference",
      "read_only": 1
    },
    {
      "fieldname": "last_error",
      "fieldtype": "Small Text",
      "label": "Delivery issue",
      "read_only": 1
    },
    {
      "fieldname": "payload",
      "fieldtype": "Code",
      "label": "Provider payload",
      "read_only": 1,
      "hidden": 1,
      "options": "JSON"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "export": 1
    }
  ],
  "sort_field": "creation",
  "sort_order": "DESC"
}
