{
  "doctype": "DocType",
  "name": "DD Recurring Occurrence",
  "module": "FieldPulse",
  "autoname": "hash",
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "plan",
    "sequence",
    "status",
    "due_date",
    "window_end",
    "source_request",
    "customer_account",
    "request",
    "access_notes",
    "access_confirmed_by",
    "access_confirmed_at",
    "decision_notes",
    "history",
    "service_category"
  ],
  "fields": [
    {
      "fieldname": "plan",
      "label": "Plan",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "DD Recurring Plan",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sequence",
      "label": "Sequence",
      "fieldtype": "Int",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "read_only": 1,
      "options": "Scheduled\nAwaiting access\nAccess confirmed\nPrepared\nCompleted\nSkipped\nMissed\nCancelled",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "due_date",
      "label": "Due Date",
      "fieldtype": "Date",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "window_end",
      "label": "Window End",
      "fieldtype": "Date",
      "read_only": 1
    },
    {
      "fieldname": "source_request",
      "label": "Source Request",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Diaspora Request"
    },
    {
      "fieldname": "customer_account",
      "label": "Customer Account",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "DD Customer Account"
    },
    {
      "fieldname": "request",
      "label": "Request",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Diaspora Request",
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "access_notes",
      "label": "Access Notes",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "access_confirmed_by",
      "label": "Access Confirmed By",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "User"
    },
    {
      "fieldname": "access_confirmed_at",
      "label": "Access Confirmed At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "decision_notes",
      "label": "Decision Notes",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "history",
      "label": "Decision history",
      "fieldtype": "Code",
      "read_only": 1,
      "options": "JSON"
    },
    {
      "fieldname": "service_category",
      "label": "Service category",
      "fieldtype": "Data",
      "read_only": 1,
      "in_standard_filter": 1,
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "Field Operations Coordinator",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Finance",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
