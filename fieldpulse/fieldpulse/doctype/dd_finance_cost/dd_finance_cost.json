{
  "doctype": "DocType",
  "name": "DD Finance Cost",
  "module": "FieldPulse",
  "fields": [
    {
      "fieldname": "request",
      "label": "Client request",
      "fieldtype": "Link",
      "options": "Diaspora Request",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "project",
      "label": "Project",
      "fieldtype": "Link",
      "options": "Field Request"
    },
    {
      "fieldname": "revisit",
      "label": "Rework / revisit",
      "fieldtype": "Link",
      "options": "DD Revisit Request"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nApproved",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "label": "Cost category",
      "fieldtype": "Select",
      "options": "Logistics\nGateway fee\nRework\nOther operating cost",
      "reqd": 1
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Data",
      "reqd": 1,
      "default": "KES"
    },
    {
      "fieldname": "amount",
      "label": "Actual approved cost",
      "fieldtype": "Currency",
      "options": "currency",
      "precision": "2",
      "reqd": 1
    },
    {
      "fieldname": "description",
      "label": "Business purpose",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "reference",
      "label": "Invoice / transaction reference",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "conversion_rate",
      "label": "Units of reporting currency per unit",
      "fieldtype": "Float",
      "precision": "8"
    },
    {
      "fieldname": "rate_date",
      "label": "Conversion-rate date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "evidence",
      "label": "Private supporting evidence",
      "fieldtype": "Attach"
    },
    {
      "fieldname": "alternative_evidence",
      "label": "Authorised alternative evidence / reference",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "approved_by",
      "label": "Approved by",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "approved_at",
      "label": "Approved at",
      "fieldtype": "Datetime",
      "read_only": 1
    }
  ],
  "field_order": [
    "request",
    "project",
    "revisit",
    "status",
    "category",
    "currency",
    "amount",
    "description",
    "reference",
    "conversion_rate",
    "rate_date",
    "evidence",
    "alternative_evidence",
    "approved_by",
    "approved_at"
  ],
  "permissions": [
    {
      "role": "Finance",
      "read": 1,
      "report": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "create": 1,
      "write": 1
    }
  ],
  "track_changes": 1,
  "autoname": "format:DFC-{#####}",
  "title_field": "name",
  "protect_attached_files": 1,
  "make_attachments_public": 0
}
