{
  "doctype": "DocType",
  "name": "DD Coordinator Alert",
  "module": "FieldPulse",
  "autoname": "field:event_key",
  "engine": "InnoDB",
  "track_changes": 0,
  "custom": 0,
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "Field Operations Coordinator",
      "read": 1
    }
  ],
  "fields": [
    {"fieldname": "event_key", "label": "Event Key", "fieldtype": "Data", "reqd": 1, "unique": 1, "hidden": 1, "read_only": 1},
    {"fieldname": "reference_doctype", "label": "Reference DocType", "fieldtype": "Link", "options": "DocType", "reqd": 1, "read_only": 1},
    {"fieldname": "reference_name", "label": "Reference Name", "fieldtype": "Dynamic Link", "options": "reference_doctype", "reqd": 1, "read_only": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Pending\nSending\nSent\nSkipped", "default": "Pending", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "attempts", "label": "Attempts", "fieldtype": "Int", "default": 0, "read_only": 1},
    {"fieldname": "next_attempt_at", "label": "Next Attempt At", "fieldtype": "Datetime", "hidden": 1, "read_only": 1},
    {"fieldname": "last_error", "label": "Last Error", "fieldtype": "Small Text", "read_only": 1}
  ]
}
