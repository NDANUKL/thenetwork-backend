    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "amount",
      "label": "Amount",
      "fieldtype": "Currency",
      "options": "currency",
      "precision": "2",
      "reqd": 1
    },
    {
      "fieldname": "reason",
      "label": "Reason and agreed/lawful basis",
      "fieldtype": "Small Text",
      "reqd": 1
