"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>{{title}}</title></head><body style=\"margin:0;background:#f3f7f6;color:#00264e;font-family:Arial,Helvetica,sans-serif\"><div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all\">{{preheader}}</div><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;background:#fefefe;border:1px solid #dce5e6;border-radius:16px\"><tr><td align=\"center\" style=\"padding:32px 24px 28px;border-bottom:1px solid #e6eeed\"><img src=\"{{origin}}/images/DD_logo.png\" width=\"174\" height=\"68\" alt=\"Diaspora Desk\" style=\"display:block;border:0;width:174px;height:auto\"></td></tr><tr><td align=\"center\" style=\"padding:32px 28px 36px;text-align:center\"><p style=\"margin:0 0 12px;color:#07786f;font-size:11px;font-weight:700;letter-spacing:1.5px\">{{eyebrow}}</p><h1 style=\"margin:0 0 16px;font-size:27px;line-height:1.25;font-weight:700;color:#00264e\">{{title}}</h1><p style=\"margin:0 0 26px;font-size:16px;line-height:1.7;color:#435c70\">{{body}}</p><table role=\"presentation\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 auto\"><tr><td bgcolor=\"#07786f\" style=\"border-radius:8px;mso-padding-alt:15px 24px\"><a href=\"{{link}}\" style=\"display:inline-block;padding:15px 24px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px\">{{label}}</a></td></tr></table><p style=\"margin:24px 0 0;font-size:13px;line-height:1.7;color:#607383\">{{note}}</p></td></tr><tr><td align=\"center\" style=\"padding:20px 24px;background:#eaf5f4;border-radius:0 0 16px 16px;font-size:12px;line-height:1.7;color:#435c70\">Diaspora Desk &middot; Follow Your Pesa</td></tr></table></td></tr></table></body></html>"
