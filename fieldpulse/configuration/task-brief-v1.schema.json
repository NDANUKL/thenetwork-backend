{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "land_property_check",
        "construction_progress",
        "business_asset_check",
        "custom_ground_verification"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30
    },
    "review_required": {
      "type": "boolean"
    },
    "review_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "response_type": {
            "type": "string",
            "enum": [
              "text",
              "single",
              "multiple",
              "none"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 30
          },
          "required": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "photo",
                    "video"
                  ]
                },
                "minimum": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "instruction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "kind",
                "minimum",
                "instruction"
              ]
            },
            "maxItems": 2
          }
        },
        "required": [
          "id",
          "instruction",
          "response_type",
          "options",
          "required",
          "evidence"
        ]
      },
      "maxItems": 50
    }
  },
  "required": [
    "schema_version",
    "category",
    "title",
    "objective",
    "scope",
    "deliverables",
    "instructions",
    "review_required",
    "review_reasons",
    "checks"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
